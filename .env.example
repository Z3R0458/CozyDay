VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_IMAGE_BUCKET=cozyday-private-images
VITE_IMAGE_RETENTION_DAYS=7
VITE_ENABLE_BROWSER_NOTIFICATIONS=true
VITE_VAPID_PUBLIC_KEY=your-web-push-vapid-public-key

# Edge Function secrets, set with `supabase secrets set`, never in frontend builds:
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CLEANUP_ADMIN_TOKEN=random-long-secret-for-manual-invocation
